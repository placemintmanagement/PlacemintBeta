JWT_SECRET=make-up-any-long-random-string
MONGO_URL=mongodb+srv://<username>:<password>@<cluster-host>/?appName=Placemint
DB_NAME=placemint

# ---- Supabase cutover: DB_BACKEND switch (Step 1, 2026-10) -----------------
# "mongo" (the default -- used whenever this var is unset, same as leaving it
# out of this file entirely) or "supabase". Gates ONLY the 7 read-only
# content banks (mcq_static_bank, mcq_pool/mcq_pool_stats, puzzle_bank,
# capgemini_round1_bank/capgemini_round2_bank, gamified_round_config) --
# every other collection (profiles, oa_attempts, interviews, reports,
# payments, auth, ...) still reads/writes Mongo regardless of this value;
# those are later cutover steps, not yet wired. A plain restart with this
# unset is byte-identical to today's behavior -- see SUPABASE_CUTOVER_PLAN.md.
# DO NOT set this to "supabase" in any real deployment without the product
# owner's explicit go-ahead; it also requires SUPABASE_DB_URL (below) to be
# set to a real Supabase Postgres connection string.
# DB_BACKEND=mongo
#
# Supabase Postgres connection string (Supabase pooler, IPv4-friendly --
# session pooler on port 5432, or transaction pooler on port 6543). Only
# needed once DB_BACKEND=supabase; see LIVE_TESTS.md for how the live
# Supabase test suite uses this same var.
# SUPABASE_URL=
# SUPABASE_DB_URL=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
INTERNAL_TESTER_EMAIL=

# ---- TEST-ONLY (2026-08, Playwright E2E click-through testing) ------------
# DO NOT SET EITHER OF THESE IN ANY REAL DEPLOYMENT.
# Leaving both unset (the default -- this .env.example ships them empty on
# purpose) means server.py's auth is 100% real Auth0 JWT verification with
# zero bypass, for every request, exactly as if these two lines didn't
# exist. They only matter if a LOCAL/CI test process explicitly sets
# ENVIRONMENT=test in ITS OWN process environment (never by editing this
# file) -- see server.py's _resolve_auth0_sub for the full safety reasoning
# (two independent conditions must both hold: ENVIRONMENT=="test" AND the
# caller presents the exact TEST_AUTH_TOKEN secret; a real Auth0 token is
# verified identically in every environment regardless of this section).
# ENVIRONMENT=
# TEST_AUTH_TOKEN=
