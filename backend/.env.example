JWT_SECRET=make-up-any-long-random-string
MONGO_URL=mongodb+srv://<username>:<password>@<cluster-host>/?appName=Placemint
DB_NAME=placemint
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
INTERNAL_TESTER_EMAIL=

# ---- TEST-ONLY (2026-08, Playwright E2E click-through testing) ------------
# DO NOT SET EITHER OF THESE IN ANY REAL DEPLOYMENT.
# Leaving both unset (the default -- this .env.example ships them empty on
# purpose) means server.py's auth is 100% real Auth0 JWT verification with
# zero bypass, for every request, exactly as if these two lines didn't
# exist. They only matter if a LOCAL/CI test process explicitly sets
# ENVIRONMENT=test in ITS OWN process environment (never by editing this
# file) -- see server.py's _resolve_auth0_sub for the full safety reasoning
# (two independent conditions must both hold: ENVIRONMENT=="test" AND the
# caller presents the exact TEST_AUTH_TOKEN secret; a real Auth0 token is
# verified identically in every environment regardless of this section).
# ENVIRONMENT=
# TEST_AUTH_TOKEN=
